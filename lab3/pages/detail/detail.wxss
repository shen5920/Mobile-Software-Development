/**detail.wxss**/
page {
  background: #ffffff;
}

.container {
  padding: 30rpx;
}

.title {
  font-size: 40rpx;
  line-height: 56rpx;
  font-weight: bold;
  color: #222222;
  text-align: left;
}

.meta {
  font-size: 24rpx;
  color: #999999;
  text-align: left;
  margin-top: 16rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.poster {
  margin-top: 24rpx;
}

.poster image {
  width: 100%;
  border-radius: 16rpx;
}

.content {
  margin-top: 24rpx;
}

.para {
  text-align: left;
  font-size: 30rpx;
  line-height: 48rpx;
  color: #333333;
  text-indent: 2em;
  margin-bottom: 20rpx;
}

.pic {
  margin: 20rpx 0;
}

.pic image {
  width: 100%;
  border-radius: 12rpx;
}

.pic-desc {
  display: block;
  text-align: center;
  font-size: 24rpx;
  color: #999999;
  margin-top: 10rpx;
}

.wen-tu {
  font-size: 26rpx;
  color: #666666;
  text-align: left;
  margin-top: 24rpx;
}

.editor {
  font-size: 26rpx;
  color: #666666;
  text-align: right;
  margin-top: 10rpx;
}

.resp-editor {
  font-size: 26rpx;
  color: #666666;
  text-align: right;
  margin-top: 10rpx;
}

/* 收藏按钮 */
.fav-btn {
  width: 500rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  margin: 48rpx auto 20rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  background: linear-gradient(135deg, #4a94e6 0%, #328EEB 100%);
  box-shadow: 0 8rpx 20rpx rgba(50, 142, 235, 0.35);
  padding: 0;
}

.fav-btn::after {
  border: none;
}

.fav-btn--active {
  color: #328EEB;
  background: #eaf2fe;
  box-shadow: none;
}
