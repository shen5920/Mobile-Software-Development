/**my.wxss**/
/* 登陆页面 */
.myLogin {
  height: 400rpx;
  background: linear-gradient(160deg, #5aa0f0 0%, #328EEB 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 40rpx 40rpx;
  box-sizing: border-box;
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255, 255, 255, 0.8);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
  background: rgba(255, 255, 255, 0.25);
}

.avatar--placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 70rpx;
}

.nickname {
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 600;
  margin-top: 24rpx;
}

.login-btn {
  margin-top: 32rpx;
  width: 360rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  background: #ffffff;
  color: #328EEB;
  font-size: 30rpx;
  font-weight: 600;
  padding: 0;
}

.login-btn::after {
  border: none;
}

/* 收藏列表 */
.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
  padding: 24rpx 20rpx 0;
}

.empty {
  text-align: center;
  color: #999999;
  font-size: 26rpx;
  padding: 80rpx 0;
}
