/* 覆盖全局容器：内容顶部排列，操作栏用 margin-top:auto 推到最底部 */
.container {
  height: auto;
  min-height: 100vh;
  justify-content: flex-start;
  padding: 30rpx 0 20rpx;
  box-sizing: border-box;
}

/* 关卡标题徽章 */
.level-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #ffffff;
  background: linear-gradient(135deg, #f5576c 0%, #E64340 100%);
  padding: 14rpx 56rpx;
  border-radius: 44rpx;
  box-shadow: 0 8rpx 20rpx rgba(230, 67, 64, 0.35);
  margin-bottom: 10rpx;
}

/* 信息栏：白底卡片 */
.info-bar {
  width: 320px;
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  font-weight: bold;
  color: #333333;
  margin: 16rpx 0;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  box-sizing: border-box;
  box-shadow: 0 4rpx 12rpx rgba(31, 45, 61, 0.08);
}

/* 剩余时间（困难模式） */
.countdown-text {
  color: #E64340;
}

/* 剩余时间少于10秒变红 */
.countdown-danger {
  color: #fa2d2d;
  font-size: 28rpx;
}

/* 游戏画布 */
canvas {
  width: 320px;
  height: 320px;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(31, 45, 61, 0.18);
}

/* 操作提示 */
.tip {
  font-size: 24rpx;
  color: #999999;
  font-weight: normal;
  margin-top: 16rpx;
}

/* 方向键整体区域：往下放一点 */
.btnBox {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 40rpx;
}

/* 方向键第二行（左、下、右） */
.btnBox view {
  display: flex;
  flex-direction: row;
}

/* 方向键按钮 */
.ctrl-btn {
  width: 108rpx;
  height: 108rpx;
  line-height: 108rpx;
  padding: 0;
  margin: 12rpx;
  border-radius: 30rpx;
  font-size: 34rpx;
  font-weight: bold;
  color: #ffffff;
  background: linear-gradient(145deg, #5aa7f0 0%, #3b8fe0 100%);
  box-shadow: 0 6rpx 16rpx rgba(59, 143, 224, 0.4);
}

.ctrl-btn::after,
.act-btn::after {
  border: none;
}

/* 操作栏：推到几乎最底部 */
.action-bar {
  display: flex;
  justify-content: center;
  margin-top: auto;
  margin-bottom: 40rpx;
}

/* 操作按钮 */
.act-btn {
  width: 160rpx;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0;
  margin: 0 8rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: bold;
  color: #ffffff;
}

.act-btn--undo {
  background: linear-gradient(135deg, #5aa7f0 0%, #3b8fe0 100%);
  box-shadow: 0 6rpx 16rpx rgba(59, 143, 224, 0.35);
}

.act-btn--restart {
  background: linear-gradient(135deg, #f5576c 0%, #E64340 100%);
  box-shadow: 0 6rpx 16rpx rgba(230, 67, 64, 0.35);
}

.act-btn--share {
  background: linear-gradient(135deg, #43b778 0%, #2f9e5f 100%);
  box-shadow: 0 6rpx 16rpx rgba(47, 158, 95, 0.35);
}

.act-btn--home {
  background: linear-gradient(135deg, #9aa7b8 0%, #7d8ba0 100%);
  box-shadow: 0 6rpx 16rpx rgba(125, 139, 160, 0.35);
}

/* 禁用态（困难模式撤销 / 回放期间） */
.ctrl-btn[disabled],
.act-btn[disabled] {
  opacity: 0.45;
  box-shadow: none;
}

/* 难度模式选择弹窗 */
.modal-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal {
  width: 600rpx;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 44rpx 40rpx;
  box-sizing: border-box;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.25);
}

.modal-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #222222;
  text-align: center;
}

.modal-desc {
  font-size: 24rpx;
  color: #999999;
  text-align: center;
  margin-top: 10rpx;
}

/* 模式选项卡片 */
.modal-mode {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  background: #f5f6f8;
  border: 3rpx solid transparent;
}

.modal-mode--active {
  background: #fdecec;
  border-color: #E64340;
}

.modal-mode-text {
  display: flex;
  flex-direction: column;
  margin-left: 16rpx;
}

.modal-mode-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
}

.modal-mode-sub {
  font-size: 24rpx;
  color: #999999;
  margin-top: 6rpx;
}

.modal-start {
  margin-top: 36rpx;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: bold;
  color: #ffffff;
  background: linear-gradient(135deg, #f5576c 0%, #E64340 100%);
  box-shadow: 0 8rpx 20rpx rgba(230, 67, 64, 0.35);
}

.modal-start::after {
  border: none;
}
