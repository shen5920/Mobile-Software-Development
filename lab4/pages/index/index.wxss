/* 覆盖全局容器：选关页内容顶部排列 */
.container {
  justify-content: flex-start;
  padding: 40rpx 0;
}

/* 标题区 */
.title-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 20rpx;
}

.subtitle {
  font-size: 26rpx;
  color: #999999;
  font-weight: normal;
  margin-top: 12rpx;
  letter-spacing: 2rpx;
}

/* 关卡列表容器 */
.levelBox {
  width: 100%;
  padding: 0 20rpx 40rpx;
  box-sizing: border-box;
  display: flex;
  flex-wrap: wrap;
}

/* 单个关卡 */
.box {
  width: 50%;
  margin: 15rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 点击反馈 */
.box-hover {
  opacity: 0.85;
  transform: scale(0.97);
}

/* 关卡白底卡片 */
.box-card {
  width: 300rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 16rpx;
  box-sizing: border-box;
  box-shadow: 0 8rpx 24rpx rgba(31, 45, 61, 0.10);
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 关卡预览图容器 */
.box-img-wrap {
  position: relative;
  width: 268rpx;
  height: 268rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

/* 关卡预览图 */
.box image {
  width: 268rpx;
  height: 268rpx;
  display: block;
}

/* 关卡编号标签 */
.level-tag {
  margin-top: 12rpx;
  font-size: 28rpx;
  font-weight: bold;
  color: #E64340;
  background: #fdecec;
  border-radius: 26rpx;
  padding: 4rpx 28rpx;
}

/* 通关标记 */
.done-mark {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 52rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  border-radius: 50%;
  background: #4caf50;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: bold;
  z-index: 2;
}

/* 锁定遮罩 */
.lock-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.55);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 64rpx;
  z-index: 1;
}
