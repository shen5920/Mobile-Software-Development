/**app.wxss**/
/* 页面浅色渐变背景 */
page {
  background: linear-gradient(180deg, #f7fafd 0%, #edf2f8 100%);
}

/* 页面容器公共样式 */
.container {
  min-height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-evenly;
}

/* 标题公共样式 */
.title {
  font-size: 44rpx;
  font-weight: bold;
  color: #E64340;
  letter-spacing: 4rpx;
}
