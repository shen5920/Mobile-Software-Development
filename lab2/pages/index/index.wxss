/**index.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  margin: 0;
  padding: 0;
  background-color: #f5f7fa;
}

.scrollarea {
  flex: 1;
  width: 100%;
}

image {
  width: 100%;
  display: block;
}

.intro-card {
  margin: 24rpx;
  padding: 40rpx 36rpx;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(22, 93, 255, 0.08);
  border: 1rpx solid #e8f0ff;
}

.card-title {
  display: flex;
  align-items: center;
  font-size: 36rpx;
  font-weight: 600;
  color: #1a3b7a;
  margin-bottom: 28rpx;
}

.title-bar {
  width: 8rpx;
  height: 32rpx;
  background: linear-gradient(180deg, #4a90d9, #165dff);
  border-radius: 4rpx;
  margin-right: 16rpx;
}

.tag-group {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.tag {
  padding: 8rpx 20rpx;
  background: #eef5ff;
  color: #165dff;
  font-size: 24rpx;
  border-radius: 30rpx;
}

.intro-text {
  font-size: 28rpx;
  line-height: 1.9;
  color: #333;
  margin-bottom: 20rpx;
  text-align: justify;
}

.motto {
  margin-top: 36rpx;
  padding: 24rpx;
  background: linear-gradient(90deg, #f0f7ff, #f8fbff);
  border-radius: 12rpx;
  text-align: center;
  border-left: 6rpx solid #4a90d9;
}

.motto-text {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
  color: #165dff;
  letter-spacing: 2rpx;
}

.motto-desc {
  display: block;
  font-size: 22rpx;
  color: #7794c2;
  margin-top: 8rpx;
}
