/* ===== 全局样式 - 光影集 ===== */
page {
  background: linear-gradient(180deg, #f5f7ff 0%, #eef1ff 100%);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
}

/* 1. 整体容器样式 */
.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 2. 卡片区域整体样式 */
.card {
  width: 710rpx;
  border-radius: 28rpx;
  background: #ffffff;
  margin: 20rpx 0;
  box-shadow: 0 8rpx 30rpx rgba(102, 126, 234, 0.12);
  overflow: hidden;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.card:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.08);
}

/* 2-1 卡片页眉 */
.card-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 24rpx 20rpx 16rpx;
}

/* 2-1-1 头像图片 - 渐变边框 */
.avatar {
  width: 90rpx;
  height: 90rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  border: 4rpx solid transparent;
  background: linear-gradient(white, white) padding-box,
              linear-gradient(135deg, #667eea, #f093fb) border-box;
}

/* 无头像时的字母兜底(尺寸/圆角由各页面尺寸类决定, 此处仅定排版与配色) */
.letter-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  overflow: hidden;
  flex-shrink: 0;
}

/* 2-1-2 文字信息 */
.title {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.title .nickName,
.nickName {
  font-size: 32rpx;
  font-weight: 600;
  color: #2d3748;
  margin-bottom: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 2-1-2(2) 所在地区 */
.address {
  font-size: 24rpx;
  color: #a0aec0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 2-2 卡片主体 */
.card-body {
  position: relative;
  width: 100%;
  background: #f7fafc;
}

.card-body image {
  width: 100%;
  display: block;
}

/* 图片描述 */
.photo-desc {
  padding: 20rpx 28rpx;
  font-size: 28rpx;
  color: #4a5568;
  line-height: 1.6;
  background: linear-gradient(135deg, #f8f9ff 0%, #f0f4ff 100%);
  word-break: break-all;
}

/* 2-3 卡片页脚 */
.card-foot {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 28rpx;
  font-size: 26rpx;
  color: #a0aec0;
}

.card-foot .date {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-foot .date::before {
  content: '📅';
  margin-right: 8rpx;
  font-size: 24rpx;
}

/* 点赞区域 */
.like-area {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 0 8rpx 16rpx;
}

.like-btn {
  font-size: 36rpx;
  line-height: 1;
  transition: transform 0.2s ease;
}

.like-btn:active {
  transform: scale(1.3);
}

.like-count {
  font-size: 26rpx;
  color: #718096;
  font-weight: 500;
}

.like-count.liked {
  color: #f56565;
}

/* ===== 浮动按钮 - 毛玻璃效果 ===== */
.floatBtn {
  position: fixed;
  bottom: 120rpx;
  right: 32rpx;
  z-index: 100;
}

.floatBtn button {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 48rpx;
  padding: 0 36rpx;
  height: 96rpx;
  box-shadow: 0 10rpx 28rpx rgba(102, 126, 234, 0.45);
  border: none;
  line-height: 1;
}

.floatBtn button::after {
  border: none;
}

.floatBtn .fab-plus {
  font-size: 44rpx;
  font-weight: 400;
  margin-bottom: 2rpx;
}

/* ===== 骨架屏 ===== */
.skeleton-card {
  width: 710rpx;
  border-radius: 28rpx;
  background: #fff;
  margin: 20rpx 0;
  padding: 24rpx;
  box-sizing: border-box;
}

.skeleton-line {
  height: 24rpx;
  background: linear-gradient(90deg, #edf2f7 25%, #e2e8f0 50%, #edf2f7 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.skeleton-avatar {
  width: 90rpx;
  height: 90rpx;
  border-radius: 50%;
  background: linear-gradient(90deg, #edf2f7 25%, #e2e8f0 50%, #edf2f7 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
  margin-bottom: 20rpx;
}

.skeleton-image {
  width: 100%;
  height: 400rpx;
  border-radius: 16rpx;
  background: linear-gradient(90deg, #edf2f7 25%, #e2e8f0 50%, #edf2f7 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
  margin-bottom: 16rpx;
}

@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* ===== 空状态 ===== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 30rpx;
  color: #a0aec0;
  margin-bottom: 10rpx;
}

.empty-subtext {
  font-size: 24rpx;
  color: #cbd5e0;
}

/* ===== 通用按钮 ===== */
.primary-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border-radius: 50rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 6rpx 20rpx rgba(102, 126, 234, 0.35);
}

.primary-btn::after {
  border: none;
}

.warn-btn {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  color: #fff;
  border-radius: 50rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 6rpx 20rpx rgba(245, 87, 108, 0.35);
}

.warn-btn::after {
  border: none;
}

/* ===== 列表底部状态(加载更多/没有更多) ===== */
.list-footer {
  padding: 30rpx 0 10rpx;
  font-size: 24rpx;
  color: #cbd5e0;
  text-align: center;
}

/* 淡入动画 */
@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(30rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.fade-in-up {
  animation: fadeInUp 0.5s ease forwards;
}

/* 点赞爱心弹出动画 */
@keyframes heartPop {
  0% { transform: scale(1); }
  50% { transform: scale(1.5); }
  100% { transform: scale(1); }
}

.heart-pop {
  animation: heartPop 0.4s ease;
}
