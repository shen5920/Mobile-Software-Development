.detail-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f5f7ff 0%, #eef1ff 100%);
  padding-bottom: 180rpx;
  box-sizing: border-box;
}

.detail-loading {
  padding: 40rpx;
}

/* ===== 作者信息栏 ===== */
.detail-author {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 24rpx 32rpx;
  background: #fff;
  margin: 20rpx;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(102, 126, 234, 0.1);
}

.detail-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  border: 3rpx solid transparent;
  background: linear-gradient(white, white) padding-box,
              linear-gradient(135deg, #667eea, #f093fb) border-box;
}

.detail-avatar-letter {
  font-size: 34rpx;
}

.detail-author-info {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}

.detail-nickname {
  font-size: 30rpx;
  font-weight: 600;
  color: #2d3748;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detail-address {
  font-size: 22rpx;
  color: #a0aec0;
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detail-meta {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-left: 12rpx;
}

.detail-date {
  font-size: 22rpx;
  color: #cbd5e0;
}

.detail-views {
  font-size: 22rpx;
  color: #a0aec0;
  margin-top: 4rpx;
}

/* ===== 大图展示 ===== */
.detail-image-wrap {
  position: relative;
  margin: 0 20rpx;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 30rpx rgba(102, 126, 234, 0.15);
  background: #fff;
}

.detail-image {
  width: 100%;
  display: block;
}

/* 双击爱心动画 */
.heart-animation {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 160rpx;
  animation: heartFloat 0.8s ease forwards;
  pointer-events: none;
}

@keyframes heartFloat {
  0% {
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.3);
  }
  30% {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1.2);
  }
  60% {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }
  100% {
    opacity: 0;
    transform: translate(-50%, -70%) scale(0.8);
  }
}

/* ===== 图片描述 ===== */
.detail-desc {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  margin: 24rpx 20rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #fff 0%, #f8f9ff 100%);
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.08);
}

.desc-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.desc-text {
  flex: 1;
  font-size: 28rpx;
  color: #4a5568;
  line-height: 1.6;
  word-break: break-all;
}

/* ===== 点赞栏 ===== */
.detail-like-bar {
  display: flex;
  justify-content: center;
  padding: 20rpx 0;
}

.like-stat {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 40rpx;
  background: #fff;
  border-radius: 50rpx;
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.1);
  transition: transform 0.2s ease;
}

.like-stat:active {
  transform: scale(0.95);
}

.like-icon {
  font-size: 36rpx;
  line-height: 1;
}

.like-text {
  font-size: 26rpx;
  color: #718096;
  font-weight: 500;
}

.like-text.liked,
.like-stat.liked .like-text {
  color: #f56565;
}

/* ===== 按钮区域 - 毛玻璃 ===== */
.detail-actions {
  display: flex;
  flex-direction: row;
  justify-content: space-around;
  margin: 0 20rpx 30rpx;
  padding: 26rpx 16rpx;
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(20px);
  border-radius: 28rpx;
  box-shadow: 0 8rpx 30rpx rgba(102, 126, 234, 0.12);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: transparent;
  border: none;
  padding: 0;
  margin: 0;
  line-height: 1.4;
  flex: 1;
}

.action-btn::after {
  border: none;
}

.action-btn:active {
  opacity: 0.6;
  transform: scale(0.95);
}

.action-delete .action-icon,
.action-delete .action-text {
  color: #f5576c;
}

.action-icon {
  font-size: 44rpx;
  margin-bottom: 8rpx;
}

.action-text {
  font-size: 24rpx;
  color: #4a5568;
  font-weight: 500;
}

/* ===== 评论区 ===== */
.comment-section {
  margin: 0 20rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(102, 126, 234, 0.08);
}

.comment-head {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f0f2f8;
}

.comment-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2d3748;
}

.comment-count {
  font-size: 22rpx;
  color: #a0aec0;
  margin-left: 12rpx;
}

.comment-item {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #f7f8fc;
}

.comment-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 3rpx solid transparent;
  background: linear-gradient(white, white) padding-box,
              linear-gradient(135deg, #667eea, #f093fb) border-box;
  flex-shrink: 0;
}

.comment-avatar.letter-avatar {
  font-size: 28rpx;
}

.comment-main {
  flex: 1;
  margin: 0 16rpx;
  min-width: 0;
}

.comment-top {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: space-between;
}

.comment-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #667eea;
}

.comment-time {
  font-size: 20rpx;
  color: #cbd5e0;
}

.comment-content {
  display: block;
  margin-top: 8rpx;
  font-size: 28rpx;
  color: #2d3748;
  line-height: 1.6;
  word-break: break-all;
}

.comment-del {
  font-size: 22rpx;
  color: #cbd5e0;
  padding: 8rpx 0 8rpx 8rpx;
}

.comment-del:active {
  color: #f5576c;
}

.comment-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0 40rpx;
  font-size: 24rpx;
  color: #a0aec0;
}

.comment-empty-icon {
  font-size: 60rpx;
  margin-bottom: 16rpx;
  opacity: 0.5;
}

.comment-loading {
  padding: 40rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #cbd5e0;
}

/* ===== 底部评论输入条 ===== */
.comment-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 200;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 16rpx 20rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(20px);
  box-shadow: 0 -4rpx 20rpx rgba(102, 126, 234, 0.1);
}

.comment-input {
  flex: 1;
  height: 72rpx;
  background: #f1f3fa;
  border-radius: 36rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  color: #2d3748;
}

.comment-input-ph {
  color: #b6bdd0;
}

.comment-send {
  margin-left: 16rpx;
  padding: 0 36rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 36rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.35);
}

.comment-send:active {
  opacity: 0.8;
}

.comment-send.disabled {
  opacity: 0.45;
  box-shadow: none;
}
