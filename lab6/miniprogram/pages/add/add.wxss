/* ===== 上传卡片 ===== */
.upload-card {
  width: 710rpx;
  background: #fff;
  border-radius: 28rpx;
  padding: 40rpx 32rpx;
  margin-top: 30rpx;
  box-shadow: 0 8rpx 30rpx rgba(102, 126, 234, 0.12);
  box-sizing: border-box;
}

.upload-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 30rpx;
}

.upload-title {
  font-size: 36rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.upload-sub {
  font-size: 24rpx;
  color: #a0aec0;
  margin-top: 8rpx;
}

/* 已选图片预览 */
.preview-zone {
  position: relative;
  width: 100%;
  height: 420rpx;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  background: #f7f8fc;
}

.preview-img {
  width: 100%;
  height: 100%;
}

.preview-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 0;
  text-align: center;
  font-size: 22rpx;
  color: #fff;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.55));
}

.rechoose-btn {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #fff;
  background: rgba(0, 0, 0, 0.45);
  backdrop-filter: blur(8px);
}

/* 描述输入 */
.desc-input-wrap {
  position: relative;
  background: #f7f8fc;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 30rpx;
  border: 2rpx solid transparent;
  transition: border-color 0.2s;
}

.desc-input {
  width: 100%;
  min-height: 80rpx;
  font-size: 28rpx;
  color: #2d3748;
  line-height: 1.5;
  box-sizing: border-box;
}

.desc-placeholder {
  color: #cbd5e0;
}

.desc-count {
  position: absolute;
  bottom: 12rpx;
  right: 20rpx;
  font-size: 20rpx;
  color: #cbd5e0;
}

/* 上传按钮 */
.upload-btn {
  width: 100%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: 600;
  padding: 20rpx 0;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.4);
}

.upload-btn::after {
  border: none;
}

.upload-btn.uploading {
  opacity: 0.8;
}

/* 进度条 */
.progress-wrap {
  margin-top: 24rpx;
}

.progress-bar {
  width: 100%;
  height: 12rpx;
  background: #edf2f7;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #667eea, #f093fb);
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

/* ===== 历史记录区域 ===== */
.history-section {
  width: 710rpx;
  margin-top: 40rpx;
}

.history-header {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 0 8rpx;
}

.history-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2d3748;
}

.history-count {
  font-size: 24rpx;
  color: #a0aec0;
}

/* 九宫格 */
.photo-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 10rpx;
}

.photo-item {
  position: relative;
  width: 230rpx;
  height: 230rpx;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.1);
}

.photo-thumb {
  width: 100%;
  height: 100%;
}

.photo-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 12rpx 16rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.5));
  pointer-events: none;
}

.photo-date {
  font-size: 20rpx;
  color: #fff;
}

.photo-del {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  font-size: 24rpx;
  color: #fff;
  background: rgba(0, 0, 0, 0.45);
}

.photo-del:active {
  background: #f5576c;
}

.load-more {
  margin-top: 26rpx;
  padding: 16rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #667eea;
  background: #fff;
  border-radius: 40rpx;
  box-shadow: 0 4rpx 16rpx rgba(102, 126, 234, 0.1);
}
